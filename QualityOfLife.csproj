<Project Sdk="Microsoft.NET.Sdk">
	<!--This is an xml comment. Comments have no impact on compiling.-->

	<PropertyGroup>
		<!--This is the .NET version the mod will be compiled with. Don't change it.-->
		<TargetFramework>net6.0</TargetFramework>

		<!--The DLL name.  It differs from the original's QualityOfLife.dll so the two never overwrite each other.-->
		<AssemblyName>QualityOfLifeLite</AssemblyName>

		<!--net6.0 is out of support, but MelonLoader 0.7.x still runs mods on it.-->
		<CheckEolTargetFramework>false</CheckEolTargetFramework>

		<!--This tells the compiler to use the latest C# version.-->
		<LangVersion>Latest</LangVersion>

		<!--This adds global usings for a few common System namespaces.-->
		<ImplicitUsings>enable</ImplicitUsings>

		<!--This enables nullable annotation and analysis. It's good coding form.-->
		<Nullable>enable</Nullable>

		<!--This tells the compiler to use assembly attributes instead of generating its own.-->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<!--PDB files give line numbers in stack traces (errors). This is useful for debugging. There are 3 options:-->
		<!--full has a pdb file created beside the dll.-->
		<!--embedded has the pdb data embedded within the dll. This is useful because bug reports will then have line numbers.-->
		<!--none skips creation of pdb data.-->
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<!--The game install folder is found through Steam's library list (TLD is app 305620).-->
	<!--Override with: dotnet build -p:TLDDir=/path/to/TheLongDark, or a TLDDir environment variable.-->
	<!--SteamDir can be overridden the same way if Steam itself lives somewhere unusual.-->
	<PropertyGroup Condition=" '$(TLDDir)' == '' ">
		<SteamDir Condition=" '$(SteamDir)' == '' And $([MSBuild]::IsOSPlatform('Windows')) ">$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\Software\Valve\Steam', 'SteamPath', null, RegistryView.Default))</SteamDir>
		<SteamDir Condition=" '$(SteamDir)' == '' And $([MSBuild]::IsOSPlatform('Windows')) ">$(MSBuildProgramFiles32)\Steam</SteamDir>
		<SteamDir Condition=" '$(SteamDir)' == '' And Exists('$(HOME)/.steam/root/steamapps') ">$(HOME)/.steam/root</SteamDir>
		<SteamDir Condition=" '$(SteamDir)' == '' And Exists('$(HOME)/.local/share/Steam/steamapps') ">$(HOME)/.local/share/Steam</SteamDir>
		<SteamDir Condition=" '$(SteamDir)' == '' And Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps') ">$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam</SteamDir>

		<_SteamLibraryFile>$(SteamDir)/steamapps/libraryfolders.vdf</_SteamLibraryFile>
		<_SteamLibraryText Condition=" Exists('$(_SteamLibraryFile)') ">$([System.IO.File]::ReadAllText('$(_SteamLibraryFile)'))</_SteamLibraryText>
		<!--The "path" of the library whose block lists app 305620 before the next library starts.-->
		<_TLDLibraryPattern>(?s)^.*?"path"\s*"([^"]*)"(?:(?!"path").)*?"305620".*$</_TLDLibraryPattern>
		<_TLDLibrary Condition=" '$(_SteamLibraryText)' != '' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(_SteamLibraryText)', '$(_TLDLibraryPattern)')) ">$([System.Text.RegularExpressions.Regex]::Replace('$(_SteamLibraryText)', '$(_TLDLibraryPattern)', '$1').Replace('\\', '\'))</_TLDLibrary>

		<TLDDir Condition=" '$(_TLDLibrary)' != '' And Exists('$(_TLDLibrary)/steamapps/common/TheLongDark') ">$(_TLDLibrary)/steamapps/common/TheLongDark</TLDDir>
		<TLDDir Condition=" '$(TLDDir)' == '' ">$(SteamDir)/steamapps/common/TheLongDark</TLDDir>
	</PropertyGroup>
	<PropertyGroup>
		<TLDMods Condition=" '$(TLDMods)' == '' ">$(TLDDir)/Mods</TLDMods>
	</PropertyGroup>

	<!--Reference the game's own assemblies, as generated by MelonLoader, so the build always matches the installed game version.-->
	<!--Run the game once with MelonLoader after each game update to regenerate them.-->
	<ItemGroup>
		<Reference Include="$(TLDDir)/MelonLoader/Il2CppAssemblies/*.dll" Private="false" />
		<Reference Include="$(TLDDir)/MelonLoader/net6/MelonLoader.dll" Private="false" />
		<Reference Include="$(TLDDir)/MelonLoader/net6/0Harmony.dll" Private="false" />
		<Reference Include="$(TLDDir)/MelonLoader/net6/Il2CppInterop.Common.dll" Private="false" />
		<Reference Include="$(TLDDir)/MelonLoader/net6/Il2CppInterop.Runtime.dll" Private="false" />
		<Reference Include="$(TLDMods)/ModSettings.dll" Private="false" />
	</ItemGroup>

	<Target Name="CheckTLDDir" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(TLDDir)')" Text="The Long Dark was not found at '$(TLDDir)'. Set TLDDir to the game folder (dotnet build -p:TLDDir=/path/to/TheLongDark, or a TLDDir environment variable)." />
		<Error Condition="!Exists('$(TLDDir)/MelonLoader/Il2CppAssemblies')" Text="Il2CppAssemblies not found in '$(TLDDir)/MelonLoader'. Run the game once with MelonLoader installed." />
	</Target>

	<Target Name="GetAssmeblyVersion" AfterTargets="Build">
		<GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
			<Output TaskParameter="Assemblies" ItemName="MyAssemblyIdentities" />
		</GetAssemblyIdentity>

		<Message Text="Assmebly Version: %(MyAssemblyIdentities.Version)" />
	</Target>

	<Target Name="CopyToMods" AfterTargets="Build" Condition=" '$(Configuration)' == 'Release' ">
		<Error Condition="!Exists('$(TLDMods)')" Text="TLDMods folder is missing.  Check value of TLDMods property." />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TLDMods)" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="Zip" AfterTargets="GetAssmeblyVersion" Condition=" '$(Configuration)' == 'Release' ">
		<RemoveDir Directories="$(IntermediateOutputPath)zip" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(IntermediateOutputPath)zip" />
		<ZipDirectory SourceDirectory="$(IntermediateOutputPath)zip" DestinationFile="TLD-QualityOfLife-Lite-%(MyAssemblyIdentities.Version).zip" Overwrite="true" />
	</Target>
</Project>
